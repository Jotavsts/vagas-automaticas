# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vagas_automaticas

# IA — provedores em ordem de tentativa (fallback automático se um falhar/acabar crédito).
# Nomes válidos: anthropic, groq, openrouter, google, cerebras, cohere, mistral, nvidia
# Todos exceto anthropic falam o protocolo OpenAI /chat/completions.
# Free tiers sem cartão de crédito: ver https://github.com/cheahjs/free-llm-api-resources
AI_PROVIDERS=anthropic,groq,openrouter,google

# anthropic (paga, ver Plans & Billing)
CLAUDE_API_KEY=your_claude_api_key
# ANTHROPIC_MODEL=claude-haiku-4-5

# groq — grátis, signup em console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# openrouter — grátis (rate limit baixo), signup em openrouter.ai
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# google (Gemini via AI Studio) — grátis, signup em aistudio.google.com
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# Server
PORT=5000
NODE_ENV=development

# Auth (defina um valor longo e aleatório no seu .env real, nunca versione o valor real)
JWT_SECRET=change_me_to_a_long_random_string

# Job Scraping
INDEED_BASE_URL=https://www.indeed.com
REMOTAR_BASE_URL=https://remotar.com.br

# Coleta automática de vagas (expressão cron). Default: a cada 3 horas.
# Use 'off' pra desativar. Ex: '0 8,20 * * *' = 8h e 20h todo dia.
COLLECT_CRON=0 */3 * * *

# CORS
FRONTEND_URL=http://localhost:5173

# Telegram — Notificações de vagas novas e Coleta de Canais (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Canais públicos para raspagem de vagas (separados por vírgula, ex: canalvagasdeti,vagas_ti_br)
TELEGRAM_JOB_CHANNELS=canalvagasdeti


